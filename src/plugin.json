{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "OTel Semconv Compliance",
  "id": "iambenzo-semconvcompliance-app",
  "backend": true,
  "executable": "gpx_semconv_compliance",
  "info": {
    "keywords": ["app", "opentelemetry", "semantic conventions"],
    "description": "Scores how well telemetry conforms to OpenTelemetry semantic conventions and shows where to fix it.",
    "author": {
      "name": "iambenzo"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Overview",
      "path": "/a/%PLUGIN_ID%/overview",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Service",
      "path": "/a/%PLUGIN_ID%/service",
      "addToNav": true,
      "defaultNav": false
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
